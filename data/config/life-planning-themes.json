    "content_rules": {
        "target_audience": "intermediate",
        "quality_tier_default": "cfp_grade",
        "required_snippets": ["not-advice", "not-tax-advice", "not-insurance-recruitment"],
        "note_char_range_standard": [8000, 10000],
        "note_char_range_cfp_grade": [12000, 15000],
        "x_char_limit": 280,
        "minimum_personas": 3,
        "minimum_sources": 10,
        "primary_source_ratio_min": 0.5
    },
    "regulatory_framework": {
        "shakaihoken_roumushi_law": {
            "article": "社会保険労務士法 第27条",
            "scope": "労働社会保険諸法令に基づく申請書等の作成・提出代行・相談業務の独占",
            "compliance_pattern": "個別年金額・標準報酬月額・給付額の確定計算は禁止。モデルケース計算と一般論解説に限定。"
        },
        "zeirishi_law": {
            "article": "税理士法 第52条",
            "scope": "税務代理・税務書類作成・税務相談の独占",
            "compliance_pattern": "個別税額の確定計算は禁止。税法の一般論解説とモデルケース計算（『年収500万円・40歳の場合』等の仮定値）に限定。"
        },
        "hoken_law": {
            "article": "保険業法 第275条",
            "scope": "保険募集（契約締結の代理・媒介）の規制",
            "compliance_pattern": "特定商品の推奨、契約への誘引は禁止。公的保障の構造解説と保険要否の判断基準提示に限定。"
        },
        "kinshouhou": {
            "article": "金融商品取引法 第28条・第29条",
            "scope": "投資助言・代理業の登録要件",
            "compliance_pattern": "個別銘柄・個別ファンドの売買推奨は禁止。一般論として『〜という特徴を持つ商品群がある』表現を使用。"
        }
    }
