<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
note-finance SNS 自動投稿 launchd エージェント
==============================================

インストール手順:
  1. プロジェクトルートのパスを確認する
       $ pwd  # note-finance ディレクトリで実行
  2. YOUR_USERNAME を実際のユーザー名に置き換える
       $ sed -i '' "s/YOUR_USERNAME/$(whoami)/g" config/launchd/com.note-finance.auto-poster.plist
  3. plist をコピーする
       $ cp config/launchd/com.note-finance.auto-poster.plist ~/Library/LaunchAgents/
  4. launchd に登録する
       $ launchctl load ~/Library/LaunchAgents/com.note-finance.auto-poster.plist
  5. 登録確認
       $ launchctl list | grep com.note-finance.auto-poster

アンインストール手順:
  $ launchctl unload ~/Library/LaunchAgents/com.note-finance.auto-poster.plist
  $ rm ~/Library/LaunchAgents/com.note-finance.auto-poster.plist

手動実行:
  $ launchctl start com.note-finance.auto-poster

注意:
  - WorkingDirectory はこのマシンの note-finance プロジェクトルートに変更してください
  - YOUR_USERNAME を実際のユーザー名に置き換えてください
  - ログファイルのパスも同様に変更してください
-->
<plist version="1.0">
<dict>
    <!-- ジョブの識別子 -->
    <key>Label</key>
    <string>com.note-finance.auto-poster</string>

    <!-- 実行するプログラムと引数 -->
    <key>ProgramArguments</key>
    <array>
        <!-- IMPORTANT: uv のパスを環境に合わせて変更してください -->
        <string>/Users/YOUR_USERNAME/.local/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>scripts/auto_poster.py</string>
    </array>

    <!-- 作業ディレクトリ（IMPORTANT: 環境に合わせて変更してください） -->
    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/Desktop/note-finance</string>

    <!-- 実行スケジュール（StartCalendarInterval: 8 スロット） -->
    <!--
    スロット一覧:
      07:00  mitsuki S1
      07:30  career_sister 朝
      12:00  mitsuki S2
      12:30  career_sister 昼
      15:00  mitsuki S3
      19:00  mitsuki S4
      20:30  career_sister 夜
      22:00  mitsuki S5
    -->
    <key>StartCalendarInterval</key>
    <array>
        <!-- mitsuki S1: 07:00 -->
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- career_sister 朝: 07:30 -->
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <!-- mitsuki S2: 12:00 -->
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- career_sister 昼: 12:30 -->
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <!-- mitsuki S3: 15:00 -->
        <dict>
            <key>Hour</key>
            <integer>15</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- mitsuki S4: 19:00 -->
        <dict>
            <key>Hour</key>
            <integer>19</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- career_sister 夜: 20:30 -->
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <!-- mitsuki S5: 22:00 -->
        <dict>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- 標準出力ログ（IMPORTANT: 環境に合わせて変更してください） -->
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/Desktop/note-finance/logs/auto-poster.log</string>

    <!-- 標準エラーログ（IMPORTANT: 環境に合わせて変更してください） -->
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/Desktop/note-finance/logs/auto-poster-error.log</string>

    <!-- 環境変数 -->
    <key>EnvironmentVariables</key>
    <dict>
        <!-- uv, python などが見つかるように PATH を設定 -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- macOS ログイン時に自動実行しない -->
    <key>RunAtLoad</key>
    <false/>

    <!-- スケジュール実行のみ（プロセス終了後の自動再起動なし） -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
